# ── Django ──────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-use-openssl-rand-hex-32
DEBUG=False
ALLOWED_HOSTS=api.carq.autos,carq.autos
CORS_ALLOWED_ORIGINS=https://carq.autos,https://www.carq.autos

# ── PostgreSQL ──────────────────────────────────────────
# POSTGRES_PASSWORD and DATABASE_URL password MUST match exactly.
# Postgres sets the password only on FIRST start (volume init).
# If you change the password later, see DEPLOY.md → "password authentication failed".
POSTGRES_USER=carq
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=carq
DATABASE_URL=postgres://carq:change-me-strong-password@postgres:5432/carq

# ── Redis ───────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── JWT (minutes) ───────────────────────────────────────
JWT_ACCESS_LIFETIME=60
JWT_REFRESH_LIFETIME=1440

# ── Frontend (build-time — rebuild after changes) ────────
NEXT_PUBLIC_API_URL=https://api.carq.autos
NEXT_PUBLIC_WS_URL=wss://api.carq.autos
NEXT_PUBLIC_SITE_URL=https://carq.autos

# ── Deploy mode ─────────────────────────────────────────
# Profiles: caddy (HTTPS), demo (JT808 simulator + live telemetry)
COMPOSE_PROFILES=caddy,demo
CADDY_EMAIL=admin@carq.autos

# Seed demo fleet/devices on backend start (first deploy only; safe to re-run)
SEED_DEMO=true

# JT808 simulator send interval (seconds)
SIMULATOR_INTERVAL=3

# ── JT808 device TCP port (host) ────────────────────────
# Change if port 8080 is already in use on the server
JT808_HOST_PORT=8080
